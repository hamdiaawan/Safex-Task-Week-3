@model IEnumerable<SafeXChat.Models.Job>
@{
    ViewData["Title"] = "Admin Panel - Pending Approval";
}

<div class="animate-fade-in">
    <div class="mb-5">
        <h1 class="fw-bold mb-1 text-danger">
           Admin Approval Panel
        </h1>
        <p class="text-muted mb-0">Review pending job postings before they are published to the public board.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 glass-card p-5 border-0">
            <div class="mb-4">
                <i class="bi bi-check-all text-success" style="font-size: 5rem;"></i>
            </div>
            <h4 class="fw-bold text-success">All Caught Up!</h4>
            <p class="text-muted mb-0">There are no jobs currently pending administrative approval.</p>
        </div>
    }
    else
    {
        <div class="card glass-card border-0 shadow-lg">
            <div class="card-header card-header-gradient" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
                <h5 class="mb-0 fw-bold"><i class="bi bi-hourglass-split me-2"></i>Pending Review (@Model.Count())</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="background: transparent;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Job Title</th>
                            <th>Budget</th>
                            <th>Work Mode</th>
                            <th>Deadline</th>
                            <th>Required Skills</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-4">@job.JobTitle</td>
                                <td>$@job.Budget.ToString("N2")</td>
                                <td>
                                    <span class="badge @(job.WorkMode == "Remote" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                        @job.WorkMode
                                    </span>
                                </td>
                                <td>@job.Deadline.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div style="max-width: 250px;" class="text-truncate">
                                        @foreach (var skill in job.RequiredSkills.Split(','))
                                        {
                                            <span class="badge bg-light text-dark border me-1 my-1" style="font-size: 0.75rem;">@skill.Trim()</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 fw-600">Pending Approval</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (!string.IsNullOrEmpty(job.AttachmentPath))
                                        {
                                            <a href="@job.AttachmentPath" class="btn btn-sm btn-outline-secondary d-flex align-items-center" download title="Download Attachment">
                                                <i class="bi bi-paperclip"></i>
                                            </a>
                                        }
                                        <form asp-action="Approve" asp-controller="Admin" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@job.Id" />
                                            <button type="submit" class="btn btn-sm btn-success d-flex align-items-center">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approve
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
